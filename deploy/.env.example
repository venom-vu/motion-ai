PORT=3001
POSTGRES_USER=motion_user
POSTGRES_PASSWORD=change_me_local_password
POSTGRES_DB=flowvis
DATABASE_URL=postgresql://motion_user:change_me_local_password@postgres-16:5432/flowvis?schema=public
REDIS_URL=redis://redis-7:6379
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long_for_dev
GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
FRONTEND_URL=http://localhost:3000
ADMIN_EMAILS=admin@flowvis.vn
COOKIE_SECURE=true

# Khóa HMAC băm IP và deviceId chống lạm dụng (đổi ở production)
# Production bắt buộc đặt, >= 32 ký tự, KHÔNG dùng chung JWT_SECRET (thiếu thì đăng ký mới sẽ lỗi).
ANTI_ABUSE_SECRET=change_me_anti_abuse_secret_at_least_32_characters_long
# Rate-limit route đăng nhập theo IP khách
AUTH_THROTTLE_LIMIT=20
AUTH_THROTTLE_TTL_MS=60000
# CIDR proxy tin cậy bổ sung ngoài dải Cloudflare (dùng cho test), phân tách bằng dấu phẩy
# BẮT BUỘC khi API chạy sau Caddy/nginx/Docker bridge: liệt kê CIDR reverse proxy, nếu không mọi user dùng chung một IP.
TRUSTED_PROXY_CIDRS=

# Nạp tiền VietQR (giá trị giữ chỗ, người triển khai điền giá trị thật)
TOPUP_BANK_BIN=970436
TOPUP_BANK_ACCOUNT_NO=0000000000
TOPUP_BANK_ACCOUNT_NAME=TEN CHU TAI KHOAN
# Webhook Discord nhận thông báo đơn nạp (để trống thì chỉ ghi log). Không commit giá trị thật.
DISCORD_WEBHOOK_URL=

# Cloudflare R2 (lưu ảnh/video và sao lưu PostgreSQL). Không commit giá trị thật.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# RunningHub (khóa API thật chỉ đặt trên VPS, không commit)
RUNNINGHUB_API_KEY=
# Để trống dùng https://www.runninghub.ai; ghi host thật (.ai hay .cn) vào docs/runninghub-api-notes.md
RUNNINGHUB_API_HOST=
RUNNINGHUB_WORKFLOW_FACESWAP=
RUNNINGHUB_MODE_FACESWAP=ai-app
RUNNINGHUB_WORKFLOW_BODY_RESHAPE=
RUNNINGHUB_MODE_BODY_RESHAPE=ai-app
RUNNINGHUB_WORKFLOW_MOTION=
RUNNINGHUB_MODE_MOTION=ai-app
# Đường dẫn endpoint số dư (bước 3 cổng trước khi bật VietQR xác nhận giá trị thật)
RH_BALANCE_ENDPOINT=
RH_BALANCE_ALERT_COINS=27000
# RH_DEADLINE_MS chỉ có tác dụng khi NODE_ENV=test (test/smoke); production bỏ qua.
# Quy đổi chi phí GPU sang VNĐ cho /admin/stats
USD_VND=25000
RH_COINS_PER_USD_RETAIL=1800
RH_COINS_PER_USD_STANDARD=3600

# Vận hành Admin
ADMIN_ADJUST_MAX=30000
# Email tài khoản benchmark (phân tách dấu phẩy); Task của họ tính vào /admin/stats scope=benchmark
BENCHMARK_USER_EMAILS=

# FE (Nuxt): email nhận báo cáo vi phạm ở chân trang (mailto:), bắt buộc ở production
NUXT_PUBLIC_REPORT_EMAIL=

# Cổng trước khi bật VietQR thương mại (scripts/prelaunch, Story 6.11). Chỉ đặt khi chạy, không commit.
# PRELAUNCH_API_URL=https://api.example.vn
# PRELAUNCH_BENCH_JWT=        # access token tài khoản benchmark (hết hạn sau 15 phút)
# PRELAUNCH_ADMIN_JWT=        # access token Admin để đọc /admin/stats
# PRELAUNCH_BENCH_REFRESH_TOKEN=  # giá trị cookie refreshToken của tài khoản benchmark; script tự POST /auth/refresh
# PRELAUNCH_ADMIN_REFRESH_TOKEN=  # giá trị cookie refreshToken của Admin (token bị xoay vòng, cũ hết hiệu lực)
# PRELAUNCH_COMPOSE=docker compose -f deploy/compose.yml --env-file deploy/.env
# PRELAUNCH_HEALTH_URL=http://127.0.0.1:3001/health
# Ghi đè ngưỡng [ASSUMPTION] (mặc định trong ngoặc):
# PRELAUNCH_DISCORD_MAX_MS=10000
# PRELAUNCH_TRIM_MAX_SECONDS=60
# PRELAUNCH_HEALTH_P95_MAX_MS=1000
# PRELAUNCH_MIN_CREATOR_MARGIN=0.7
# PRELAUNCH_COINS_PER_GPU_SECOND=0.4  # coin RunningHub cho mỗi giây GPU: giây GPU = gpu_coins / giá trị này
# PRELAUNCH_DURATION_TOLERANCE=0.5
# PRELAUNCH_FACESWAP_SLA_SECONDS=60
# PRELAUNCH_BENCHMARK_SAMPLES=20
# PRELAUNCH_BODY_INTENSITIES=3,3,5,5,8
# PRELAUNCH_MOTION_SECONDS=3,3,5,5,5,10,10,15,15,20
