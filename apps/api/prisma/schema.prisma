generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model InfraProbe {
  id        String   @id @default(uuid()) @db.Uuid
  probeKey  String   @unique @map("probe_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("infra_probes")
}
