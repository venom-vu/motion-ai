generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model InfraProbe {
  id        String   @id @default(uuid()) @db.Uuid
  probeKey  String   @unique @map("probe_key")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("infra_probes")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  googleId      String         @unique @map("google_id")
  email         String         @unique @map("email")
  role          String         @default("user") @map("role")
  tosVersion    String         @map("tos_version")
  tosAcceptedAt DateTime       @default(now()) @map("tos_accepted_at") @db.Timestamptz(6)
  lockedAt      DateTime?      @map("locked_at") @db.Timestamptz(6)
  balance       BigInt         @default(0) @map("balance")
  held          BigInt         @default(0) @map("held")
  tierPack      String?        @map("tier_pack")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshTokens RefreshToken[]
  ledgerEntries LedgerEntry[]
  signupGrant   SignupGrant?
  uploads       Upload[]
  tasks         Task[]
  shareTokens   ShareToken[]
  topups        Topup[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model LedgerEntry {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @map("type")
  amount    BigInt   @map("amount")
  taskId    String?  @map("task_id") @db.Uuid
  topupId   String?  @map("topup_id") @db.Uuid
  pack      String?  @map("pack")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Restrict)
  topup     Topup?   @relation(fields: [topupId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("ledger_entries")
}

model SignupGrant {
  userId          String   @id @map("user_id") @db.Uuid
  fingerprintHash String   @map("fingerprint_hash")
  ipHash          String   @map("ip_hash")
  granted         BigInt   @map("granted")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ipHash, createdAt])
  @@map("signup_grants")
}

model Upload {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  key             String    @unique @map("key")
  confirmedKey    String?   @map("confirmed_key")
  kind            String    @map("kind")
  status          String    @default("pending") @map("status")
  mimeType        String    @map("mime_type")
  declaredBytes   Int       @map("declared_bytes")
  sizeBytes       Int?      @map("size_bytes")
  etag            String?   @map("etag")
  width           Int?      @map("width")
  height          Int?      @map("height")
  durationSeconds Int?      @map("duration_seconds")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt     DateTime? @map("confirmed_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("uploads")
}

model Task {
  id              String        @id @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  pipeline        String        @map("pipeline")
  status          String        @default("queued") @map("status")
  reasonCode      String?       @map("reason_code")
  resultKey       String?       @map("result_key")
  tierSnapshot    Json          @map("tier_snapshot")
  consent         Boolean       @map("consent")
  tosVersion      String        @map("tos_version")
  inputKeys       Json          @map("input_keys")
  params          Json          @default("{}") @map("params")
  holdAmount      Int           @map("hold_amount")
  queuedAt        DateTime      @default(now()) @map("queued_at") @db.Timestamptz(6)
  enqueueAttempts Int           @default(0) @map("enqueue_attempts")
  runningAt         DateTime?   @map("running_at") @db.Timestamptz(6)
  prepDeadlineAt    DateTime?   @map("prep_deadline_at") @db.Timestamptz(6)
  deadlineAt        DateTime?   @map("deadline_at") @db.Timestamptz(6)
  submitStartedAt   DateTime?   @map("submit_started_at") @db.Timestamptz(6)
  finishedAt        DateTime?   @map("finished_at") @db.Timestamptz(6)
  rhOrphanUntil     DateTime?   @map("rh_orphan_until") @db.Timestamptz(6)
  gateDeadline      DateTime?   @map("gate_deadline") @db.Timestamptz(6)
  runninghubTaskId  String?     @map("runninghub_task_id")
  gpuCoins          Int?        @map("gpu_coins")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries   LedgerEntry[]
  shareTokens     ShareToken[]

  @@index([userId, status])
  @@index([status, queuedAt])
  @@map("tasks")
}

model ShareToken {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("share_tokens")
}

model Topup {
  id                String        @id @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  code              String        @unique @map("code")
  pack              String        @map("pack")
  amountVnd         Int           @map("amount_vnd")
  status            String        @default("awaiting_transfer") @map("status")
  qrExpiresAt       DateTime      @map("qr_expires_at") @db.Timestamptz(6)
  approveBy         DateTime?     @map("approve_by") @db.Timestamptz(6)
  bankRef           String?       @unique @map("bank_ref")
  rejectReason      String?       @map("reject_reason")
  note              String?       @map("note")
  tosVersion        String        @map("tos_version")
  notifiedAt        DateTime?     @map("notified_at") @db.Timestamptz(6)
  overdueNotifiedAt DateTime?     @map("overdue_notified_at") @db.Timestamptz(6)
  notifyAttempts    Int           @default(0) @map("notify_attempts")
  notifyAttemptedAt DateTime?     @map("notify_attempted_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledgerEntries     LedgerEntry[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)], map: "topups_user_id_created_at_idx")
  @@index([status])
  @@map("topups")
}
