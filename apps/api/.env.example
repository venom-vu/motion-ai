PORT=3001
DATABASE_URL=postgresql://motion_user:change_me_local_password@localhost:5432/motion_ai?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_jwt_secret_at_least_32_characters_long_for_dev
GOOGLE_CLIENT_ID=mock_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
FRONTEND_URL=http://localhost:3000
ADMIN_EMAILS=admin@motionai.vn
COOKIE_SECURE=true

# Khóa HMAC băm IP và deviceId chống lạm dụng (đổi ở production)
# Production bắt buộc đặt, >= 32 ký tự, KHÔNG dùng chung JWT_SECRET (thiếu thì đăng ký mới sẽ lỗi).
ANTI_ABUSE_SECRET=change_me_anti_abuse_secret_at_least_32_characters_long
# Rate-limit route đăng nhập theo IP khách
AUTH_THROTTLE_LIMIT=20
AUTH_THROTTLE_TTL_MS=60000
# CIDR proxy tin cậy bổ sung ngoài dải Cloudflare (dùng cho test), phân tách bằng dấu phẩy
# BẮT BUỘC khi API chạy sau Caddy/nginx/Docker bridge: liệt kê CIDR reverse proxy, nếu không mọi user dùng chung một IP.
TRUSTED_PROXY_CIDRS=

# Cloudflare R2 (S3-compatible). Bucket riêng tư; cấu hình CORS/lifecycle bằng:
#   pnpm --filter @motion-ai/api run build && node apps/api/dist/scripts/configure-bucket.js
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=motion-ai
# Tùy chọn: ghi đè endpoint (mặc định https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# RunningHub. Không có RUNNINGHUB_API_KEY thì dùng adapter "chưa cấu hình" (mọi lời gọi ném RH_ERROR).
# API key tạo ở trang API Key của RunningHub; không commit giá trị thật.
RUNNINGHUB_API_KEY=
# Tùy chọn: ghi đè host (mặc định https://www.runninghub.ai)
RUNNINGHUB_API_HOST=
# ID workflow Face Swap trên RunningHub; nodeId/fieldName đối chiếu ở pipelines/pipeline-config.ts
RUNNINGHUB_WORKFLOW_FACESWAP=
# Số Task tối đa đã qua cổng đồng thời (gồm orphan còn hạn)
RH_MAX_CONCURRENT=2
# Chu kỳ thử lại khi cổng đầy (ms)
RH_GATE_RETRY_MS=5000
# Chu kỳ poll kết quả RunningHub (ms)
RH_POLL_INTERVAL_MS=3000

# Nạp credit VietQR: tài khoản nhận tiền (BẮT BUỘC để tạo đơn nạp; chưa có giá trị thật thì [ASSUMPTION])
# BIN ngân hàng NAPAS 6 chữ số (ví dụ 970422 = MB)
TOPUP_BANK_BIN=
TOPUP_BANK_ACCOUNT_NO=
TOPUP_BANK_ACCOUNT_NAME=
# Rate-limit POST /topups
TOPUP_THROTTLE_LIMIT=10
TOPUP_THROTTLE_TTL_MS=60000
